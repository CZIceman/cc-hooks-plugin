{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env MAREK_HOOK_KLIENT=codex python3 \"${PLUGIN_ROOT}/hooks/codex-uklid.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "env MAREK_HOOK_KLIENT=codex bash \"${PLUGIN_ROOT}/hooks/baze-start.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "env MAREK_HOOK_KLIENT=codex bash \"${PLUGIN_ROOT}/hooks/pravidla-start.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(resume|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "env MAREK_HOOK_KLIENT=codex python3 \"${PLUGIN_ROOT}/hooks/dohled-start.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env MAREK_HOOK_KLIENT=codex python3 \"${PLUGIN_ROOT}/hooks/pretool-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "env MAREK_HOOK_KLIENT=codex python3 \"${PLUGIN_ROOT}/hooks/pretool-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "(?i)^mcp__second[-_]brain__pravidla$",
        "hooks": [
          {
            "type": "command",
            "command": "env MAREK_HOOK_KLIENT=codex python3 \"${PLUGIN_ROOT}/hooks/pretool-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env MAREK_HOOK_KLIENT=codex python3 \"${PLUGIN_ROOT}/hooks/stop-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env MAREK_HOOK_KLIENT=codex python3 \"${PLUGIN_ROOT}/hooks/ack-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
